# AI Support Workflow Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Zendesk Configuration
ZENDESK_SUBDOMAIN=your-company-support
ZENDESK_EMAIL=ai-workflows@your-company.com
ZENDESK_API_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Jira Service (if using instead of Zendesk)
JIRA_DOMAIN=your-company.atlassian.net
JIRA_EMAIL=ai-workflows@your-company.com
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX=support-kb

# Optional: Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#ai-workflows

# Optional: Cloud Deployment (Google Cloud)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_SERVICE_KEY=/path/to/service-key.json

# Optional: AWS Deployment
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=production

# Triage Settings
MIN_CONFIDENCE_THRESHOLD=0.75
AUTO_ROUTE_ENABLED=true
KB_RESULTS_COUNT=3

# Response Generation
RESPONSE_MAX_LENGTH=1000
INCLUDE_KB_ARTICLES=true
INCLUDE_SUGGESTED_TAGS=true

# Monitoring
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
METRICS_ENABLED=true
